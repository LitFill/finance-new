#!/bin/bash
# pre-commit hook: validasi & rapikan jurnal sebelum masuk git
# Aktifkan sekali: git config core.hooksPath .githooks

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

STAGED=$(git diff --cached --name-only --diff-filter=ACM -- '*.journal')
[ -z "$STAGED" ] && exit 0

FAILED=0
for f in $STAGED; do
    echo "» Validasi: $f"
    if ! hledger check -s -f "$f"; then
        echo "✗ $f gagal hledger check -s — commit dibatalkan." >&2
        FAILED=1
        continue
    fi
    ./fmt-journal "$f" >/dev/null
    if ! git diff --quiet -- "$f"; then
        git add -- "$f"
        echo "» Diformat ulang & di-stage: $f"
    fi
    rm -f "${f}.backup"
done

exit $FAILED
